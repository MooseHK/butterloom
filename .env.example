# Origin
PORT=3000

# SQLite lives on the instance's persistent volume (ADR-0006).
BUTTERLOOM_DB=./var/butterloom.db

# Local stand-in for object storage. In production these become the bucket and
# the CDN hostname in front of it (ADR-0007).
BUTTERLOOM_MEDIA_DIR=./var/media
BUTTERLOOM_MEDIA_BASE_URL=/media

# Encoder subprocesses (ADR-0007): libvips-tools.
BUTTERLOOM_VIPS_BIN=vips
BUTTERLOOM_VIPSHEADER_BIN=vipsheader

BUTTERLOOM_MAX_UPLOAD_BYTES=20971520

# The admin runs unauthenticated when these are unset. Set both anywhere but a
# laptop.
BUTTERLOOM_ADMIN_USER=
BUTTERLOOM_ADMIN_PASSWORD=
